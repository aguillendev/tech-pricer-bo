# ─────────────────────────────────────────────────────────────────────────────
# Tech Pricer - Frontend Environment Variables
# Copiá este archivo como .env y completá los valores para tu entorno.
# ─────────────────────────────────────────────────────────────────────────────

# URL base del backend (sin trailing slash)
VITE_API_BASE_URL=http://localhost:8080/api

# URL de la API de cotización del dólar (dolarapi.com - dólar oficial BNA)
VITE_DOLAR_API_URL=https://dolarapi.com/v1/dolares/oficial
